{
  "name": "tradetracker/rest-php-sdk",
  "description": "Dependency-free PHP client SDK for the TradeTracker Web Services REST API.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "TradeTracker\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TradeTracker\\Sdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
